# The Ambient poll (optional).
#
# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> API -> Project URL, and the "anon public" key.
#
# Both values are public. The anon key is designed to be shipped to browsers;
# what protects a Supabase project is its access rules, not this key's secrecy.
#
# Leave them out and the room still works — presence just becomes per-browser
# (real across tabs, invisible across devices) instead of cross-device.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cross-device presence. For a local Worker: `npx wrangler dev` in
# workers/presence, then ws://localhost:8787/presence. Unset, presence stays
# within one browser (real across tabs).
NEXT_PUBLIC_PRESENCE_URL=
