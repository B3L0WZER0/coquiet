{
  "name": "coquiet",
  "version": "0.2.0",
  "private": true,
  "description": "Quiet company for focused work.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contrast": "node scripts/contrast-check.mjs",
    "assets:images": "node scripts/generate-images.mjs",
    "assets:crops": "node scripts/crop-preview.mjs",
    "assets:audio": "node scripts/generate-audio-manifest.mjs",
    "audio:intake": "node scripts/audio-intake.mjs",
    "audio:upload": "node scripts/audio-intake.mjs --upload-only",
    "audio:worker": "npx wrangler deploy --config workers/audio/wrangler.jsonc",
    "assets:og": "node --experimental-strip-types scripts/generate-og-image.mjs",
    "assets:icons": "node scripts/generate-app-icons.mjs",
    "assets:journal": "node --experimental-strip-types scripts/generate-journal-cards.mjs",    "room": "node scripts/room-peek.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "music-metadata": "^11.15.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
