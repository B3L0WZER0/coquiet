{
  // A throwaway copy of the site for trying changes before they go live.
  // Deployed by hand (`npm run preview:deploy`), never by CI, and on its own
  // workers.dev hostname — coquiet.app and GitHub Pages are untouched.
  "name": "coquiet-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,

  // The static export. Everything but the music is served from here.
  "assets": {
    "directory": "../../.next-preview",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/audio/*"]
  },

  // The same bucket the live room plays from, read-only in practice, so the
  // Music room works here too and on the page's own origin, as in production.
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "coquiet-audio" }]
}
